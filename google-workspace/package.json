{
  "name": "portail-google-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Trousse d'automatisation de la mise en place du Google Workspace de Portail (gestion immobilière) : groupe d'équipe, calendriers partagés et Drive partagé. Mode simulation par défaut : rien n'est modifié sans --apply.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "portail-gw": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "config.example.json",
    "README.md"
  ],
  "scripts": {
    "init": "node src/cli.mjs init",
    "init:apply": "node src/cli.mjs init --apply",
    "doctor": "node src/cli.mjs doctor",
    "audit": "node src/cli.mjs audit",
    "setup": "node src/cli.mjs setup",
    "setup:apply": "node src/cli.mjs setup --apply",
    "detach": "node src/cli.mjs detach",
    "verify": "node src/cli.mjs verify",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "googleapis": "^178.0.0"
  }
}
