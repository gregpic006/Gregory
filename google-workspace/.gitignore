# Secrets — ne JAMAIS commiter ces fichiers.
# Ils donnent un acces administrateur complet au Google Workspace.
service-account.json
oauth-client.json
.tokens.json

# Configuration reelle (contient les adresses et le domaine du client).
# Le modele a commiter est config.example.json.
config.json

# Cache local des identifiants deja crees. Ce n'est qu'une optimisation :
# la trousse redecouvre tout via l'API si le fichier est absent.
.state.json

# Dependances
# (sans barre oblique : attrape aussi un lien symbolique, qu'un motif
#  « node_modules/ » laisserait passer)
node_modules

# Bruit divers
*.log
npm-debug.log*
.DS_Store

# Bancs d'essai jetables créés pendant le développement.
# Ils contiennent des copies de fichiers de src/ : versionner ces doublons
# les ferait diverger du vrai code. Le test de fumée officiel vit dans scripts/.
.smoketest/
