# =============================================================================
# JARVIS - exemple de configuration.  Copier vers .env et remplir.
# NE JAMAIS committer le fichier .env.
# =============================================================================

# --- Identite / localisation -------------------------------------------------
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Greg
JARVIS_DEFAULT_LANGUAGE=fr-CA
JARVIS_TIMEZONE=America/Montreal

# --- Environnement -----------------------------------------------------------
# development | production
JARVIS_ENV=development
# En development, toute action externe (envoi de courriel, etc.) est simulee.
JARVIS_DRY_RUN=true
JARVIS_LOG_LEVEL=INFO

# --- Serveur -----------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
# Origines autorisees pour le navigateur / l'app desktop (separees par des virgules)
JARVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM ---------------------------------------------------------------------
# anthropic | mock   (mock = aucun appel reseau, utile hors ligne et en test)
JARVIS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Routage par niveau de complexite
JARVIS_LLM_MODEL_FAST=claude-haiku-4-5
JARVIS_LLM_MODEL_BALANCED=claude-opus-5
JARVIS_LLM_MODEL_DEEP=claude-opus-5
JARVIS_LLM_MAX_TOKENS=2000
# Budget quotidien en dollars US; 0 = illimite
JARVIS_LLM_DAILY_BUDGET_USD=5.0

# --- Speech-to-Text ----------------------------------------------------------
# openai | faster_whisper | null
JARVIS_STT_PROVIDER=null
OPENAI_API_KEY=
JARVIS_STT_OPENAI_MODEL=gpt-4o-transcribe
JARVIS_STT_LOCAL_MODEL=small
JARVIS_STT_LOCAL_COMPUTE=int8

# --- Text-to-Speech ----------------------------------------------------------
# elevenlabs | openai | null   (null = la voix du systeme est utilisee cote client)
JARVIS_TTS_PROVIDER=null
ELEVENLABS_API_KEY=
JARVIS_TTS_ELEVENLABS_VOICE_ID=
JARVIS_TTS_ELEVENLABS_MODEL=eleven_turbo_v2_5
JARVIS_TTS_OPENAI_MODEL=gpt-4o-mini-tts
JARVIS_TTS_OPENAI_VOICE=onyx
# Timbre (ElevenLabs). Stabilite haute + style bas = voix posee d'assistant.
# Style eleve = livraison theatrale: a eviter ici.
JARVIS_TTS_STABILITY=0.55
JARVIS_TTS_SIMILARITY=0.80
JARVIS_TTS_STYLE=0.10
JARVIS_TTS_SPEAKER_BOOST=true

# --- Google Workspace (Gmail, Calendar, Contacts) ----------------------------
# Cree un client OAuth de type "Application de bureau" dans Google Cloud Console.
# Voir docs/google-setup.md pour la marche a suivre complete.
# Le mot de passe Google n'est JAMAIS demande ni stocke.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Laisser vide: deduit automatiquement de JARVIS_HOST et JARVIS_PORT.
GOOGLE_REDIRECT_URI=

# --- Base de donnees ---------------------------------------------------------
# sqlite:///chemin  (MVP)  -- postgres viendra en M4
JARVIS_DATABASE_URL=sqlite:///data/jarvis.db

# --- Securite ----------------------------------------------------------------
# Cle Fernet base64 (32 octets). Generer avec:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_ENCRYPTION_KEY=
# Palier maximum executable sans confirmation explicite (0..4)
JARVIS_AUTO_APPROVE_MAX_LEVEL=1
JARVIS_AUTO_SEND_EMAIL=false

# --- Feature flags -----------------------------------------------------------
JARVIS_FEATURE_VOICE=true
JARVIS_FEATURE_WAKE_WORD=false
JARVIS_FEATURE_GMAIL=false
JARVIS_FEATURE_CALENDAR=false
JARVIS_FEATURE_DOCUMENTS=false
# Google Drive: exige un consentement supplementaire (voir docs/google-setup.md).
JARVIS_FEATURE_DRIVE=false
JARVIS_FEATURE_PERSISTENT_MEMORY=true
JARVIS_FEATURE_COMPUTER_CONTROL=false
JARVIS_FEATURE_AUTONOMOUS_MODE=false

# --- Documents (M3) ----------------------------------------------------------
# Dossier surveille par « jarvis index ». Sous Windows, un chemin complet
# fonctionne aussi: C:\Users\greg\Documents\JARVIS
JARVIS_DOCUMENTS_DIR=data/documents

# Recherche semantique. A false, la recherche reste lexicale (mots exacts):
# elle fonctionne hors ligne, sans aucun telechargement, et le dit.
JARVIS_EMBEDDING_ENABLED=true
# Modele multilingue (~220 Mo), telecharge une seule fois au premier usage.
JARVIS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Vide = cache par defaut de la librairie.
JARVIS_EMBEDDING_CACHE_DIR=

# Nom (ou identifiant) du dossier Drive a indexer. JARVIS ne lit que ce
# dossier, meme si la portee Google en permettrait davantage.
JARVIS_DRIVE_FOLDER=JARVIS
